diff --git a/BSP/bsp_timer.c b/BSP/bsp_timer.c
new file mode 100644
index 0000000..df5896b
--- /dev/null
+++ b/BSP/bsp_timer.c
@@ -0,0 +1,74 @@
+#include "bsp_timer.h"
+
+static volatile uint32_t s_tim2_events;
+static volatile uint32_t s_tim4_events;
+
+HAL_StatusTypeDef BSP_Timer2_Start(void)
+{
+    /* Legacy time2.c:21,23,32: CNT=0, UIE enabled, counter started.
+     * MX_TIM2_Init() must already have configured PSC=83 / ARR=999.
+     */
+    s_tim2_events = 0U;
+    __HAL_TIM_SET_COUNTER(&htim2, 0U);
+    /* An intentional defensive difference: ignore stale UIF on start. */
+    __HAL_TIM_CLEAR_FLAG(&htim2, TIM_FLAG_UPDATE);
+    return HAL_TIM_Base_Start_IT(&htim2);
+}
+
+HAL_StatusTypeDef BSP_Timer4_Start(void)
+{
+    /* Legacy time2.c:75,77,83: CNT=0, UIE enabled, counter started.
+     * MX_TIM4_Init() must already have PSC=10 / ARR=10000.
+     */
+    s_tim4_events = 0U;
+    __HAL_TIM_SET_COUNTER(&htim4, 0U);
+    __HAL_TIM_CLEAR_FLAG(&htim4, TIM_FLAG_UPDATE);
+    return HAL_TIM_Base_Start_IT(&htim4);
+}
+
+void BSP_Timer_1msTick(void)
+{
+    /* Diagnostic only. Legacy's calculate_motor_parameters() and its
+     * theta/Speed_actual writes belong to the subsequent Control/Motor
+     * integration. This is NOT yet a behavior-equivalent TIM2 ISR.
+     */
+    ++s_tim2_events;
+}
+
+void BSP_Timer4_Tick(void)
+{
+    /* Diagnostic only. Legacy clears motorX_pluse/motorY_pluse and bumps
+     * motorX_position/motorY_position here. Motion is NOT yet migrated.
+     */
+    ++s_tim4_events;
+}
+
+uint32_t BSP_Timer_GetTim2Events(void)
+{
+    return s_tim2_events;
+}
+
+uint32_t BSP_Timer_GetTim4Events(void)
+{
+    return s_tim4_events;
+}
+
+void BSP_Timer4_SetAutoReload(uint16_t arr)
+{
+    __HAL_TIM_SET_AUTORELOAD(&htim4, (uint32_t)arr);
+}
+
+uint16_t BSP_Timer4_GetAutoReload(void)
+{
+    return (uint16_t)__HAL_TIM_GET_AUTORELOAD(&htim4);
+}
+
+void BSP_Timer4_ResetCounter(void)
+{
+    __HAL_TIM_SET_COUNTER(&htim4, 0U);
+}
+
+uint16_t BSP_Timer4_GetCounter(void)
+{
+    return (uint16_t)__HAL_TIM_GET_COUNTER(&htim4);
+}
diff --git a/BSP/bsp_timer.h b/BSP/bsp_timer.h
new file mode 100644
index 0000000..3de8e98
--- /dev/null
+++ b/BSP/bsp_timer.h
@@ -0,0 +1,39 @@
+#ifndef BSP_TIMER_H
+#define BSP_TIMER_H
+
+#include <stdint.h>
+#include "tim.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Phase 2: TIM2 and TIM4 timing only; no motor algorithm or pulse output.
+ * TIM2: STM32F407 APB1 timer clock 84MHz, PSC=83, ARR=999 -> nominal 1ms.
+ * TIM4: PSC=10, ARR=10000 -> ~1.31ms at 84MHz, NOT a 10ms timer.
+ * TIM2 is a temporary PM1 timebase: PM2 encoder needs TIM2 CH1/CH2.
+ */
+HAL_StatusTypeDef BSP_Timer2_Start(void);
+HAL_StatusTypeDef BSP_Timer4_Start(void);
+
+/* Call once per corresponding HAL_TIM_PeriodElapsedCallback dispatch. */
+void BSP_Timer_1msTick(void);
+void BSP_Timer4_Tick(void);
+
+/* Diagnostic event counters, NOT a validated absolute clock. */
+uint32_t BSP_Timer_GetTim2Events(void);
+uint32_t BSP_Timer_GetTim4Events(void);
+
+/* Legacy main.c directly writes TIM4->ARR/CNT for the XY scheduler.
+ * The motion layer must later consume these HAL wrappers rather than
+ * directly editing timer registers. No step pulse is generated here.
+ */
+void BSP_Timer4_SetAutoReload(uint16_t arr);
+uint16_t BSP_Timer4_GetAutoReload(void);
+void BSP_Timer4_ResetCounter(void);
+uint16_t BSP_Timer4_GetCounter(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
