config load DMF407_FOC_HAL.ioc
waitclock 2
get gpio parameters PF10 PinState
get gpio parameters PF10 GPIO_Speed
get gpio parameters PF10 GPIO_PuPd
set gpio parameters PF10 PinState GPIO_PIN_RESET
get gpio parameters PF10 PinState
get ip parameters RCC PLLQ
get ip parameters RCC PLLQCLKFreq_Value
config save
project generate
exit